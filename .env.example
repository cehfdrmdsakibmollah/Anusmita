
# Mandatory (MongoDB Atlas replica-set required for ACID checkout transactions)
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>/anusmita?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used only by the local, one-time create-owner CLI. NEVER expose NEXT_PUBLIC secrets.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password-at-least-14-characters
# Optional configuration: amounts are integer BDT paisa (100 paisa = 1 BDT)
SHIPPING_DHAKA_PAISA=7000
SHIPPING_OTHER_PAISA=12000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product image URLs are delivered from existing Cloudinary cloud oseohmxd.
# Admin-media connector manages uploads; no public API key or browser secret is needed for URL linking.
