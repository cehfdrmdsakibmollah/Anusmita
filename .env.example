
# Mandatory (MongoDB Atlas replica-set required for ACID checkout transactions)
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@anusmita.jvvjo1k.mongodb.net/anusmita?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters
# Used only by the local, one-time create-owner CLI. NEVER expose NEXT_PUBLIC secrets.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password-at-least-14-characters
# Optional configuration: amounts are integer BDT paisa (100 paisa = 1 BDT)
SHIPPING_DHAKA_PAISA=7000
SHIPPING_OTHER_PAISA=12000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product image URLs are delivered from existing Cloudinary cloud oseohmxd.
# Admin-media connector manages uploads; no public API key or browser secret is needed for URL linking.

# Optional, required ONLY for signed direct image uploads and server-side Drive→Cloudinary migration.
# Cloudinary plugin authorization is separate from the website, so configure these on the server.
# Copy from your Cloudinary Console; never commit real credentials or expose the API secret.
CLOUDINARY_CLOUD_NAME=oseohmxd
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
MEDIA_DAILY_UPLOAD_LIMIT=10

# Launch safety. Default: catalog-only, even in production.
# Set "live" ONLY after HTTPS hosting, isolated Atlas database,
# owner verification, payment/courier process tests and legal checks.
STORE_MODE=catalog
